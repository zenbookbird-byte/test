# ═══════════════════════════════════════════════════════════════
# Solana Trading Terminal — API Configuration
# Copy to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ── Solana RPC (pick ONE, Helius recommended) ──────────────────
# Helius: https://helius.dev   — Free: 100K credits/mo, Hacker: $49/mo
VITE_HELIUS_API_KEY=
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Fallback public RPC (rate-limited, not for production)
VITE_SOLANA_RPC_FALLBACK=https://api.mainnet-beta.solana.com

# ── Birdeye (token analytics) ─────────────────────────────────
# https://birdeye.so/api  — Free: 100 req/day, Starter: $49/mo
VITE_BIRDEYE_API_KEY=

# ── Helius Enhanced APIs (DAS, webhooks, parsed txns) ─────────
# Uses same key as RPC above
# Included in Helius plan

# ── GoPlus Security (token audit) ─────────────────────────────
# https://gopluslabs.io  — Free: 200 req/day (no key needed for basic)
# Pro: $99/mo for higher limits + webhook alerts
VITE_GOPLUS_API_KEY=

# ── Jupiter (DEX aggregator) ─────────────────────────────────
# Free, no key required. Optional paid metis endpoint:
# https://docs.jup.ag  — $250/mo for dedicated endpoint
VITE_JUPITER_ENDPOINT=https://quote-api.jup.ag/v6

# ── DexScreener ───────────────────────────────────────────────
# Free tier (rate-limited). Paid plans via contact.
# No API key needed for public endpoints.

# ── Binance (perpetuals pricing) ──────────────────────────────
# Free WebSocket, no key needed
# wss://stream.binance.com:9443

# ── TradingView (charts) ─────────────────────────────────────
# Free widget embed. Advanced charting library: contact TradingView.
# No key needed for widget.

# ── CoinGecko (fallback prices) ──────────────────────────────
# Free: 30 req/min. Pro: $49/mo for 500 req/min + API key
VITE_COINGECKO_API_KEY=

# ── Optional: Analytics ──────────────────────────────────────
# VITE_POSTHOG_KEY=
# VITE_SENTRY_DSN=
