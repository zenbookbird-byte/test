# ─── Polymarket Copy Trader — example config ───────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Your Polymarket wallet ──────────────────────────────────────
# The private key of the wallet you use on Polymarket.
# Fund it with USDC on Polygon before running.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Trading mode ────────────────────────────────────────────────
# paper (default) = simulate, no real orders
# live            = real orders (requires POLYMARKET_PRIVATE_KEY)
PAPER_TRADE=true

# ── Markets to copy ─────────────────────────────────────────────
# war  = Iran / Israel / US war markets  (data/war_data.json)
# btc  = Bitcoin price markets           (data/crypto_wallets.json → generated by wallet_scout.py)
# eth  = Ethereum price markets          (data/crypto_wallets.json)
# sol  = Solana price markets            (data/crypto_wallets.json)
MODE=btc

# ── Risk / sizing ────────────────────────────────────────────────
COPY_BUDGET_USDC=50       # total USDC available for all copy positions
MAX_POSITION_USDC=5       # cap per single market — keep LOW during trial ($5 max)
MIN_COPY_WALLETS=2        # how many tracked wallets must agree before copying
SUCCESS_RATE=0.82         # assumed win-rate for Kelly sizing (match dashboard)

# ── Price filters ────────────────────────────────────────────────
MAX_YES_PRICE=0.90        # don't buy if YES is already > 90 cents (too expensive)
MIN_YES_PRICE=0.03        # don't buy if YES is < 3 cents (too risky)

# ── Execution ────────────────────────────────────────────────────
POLL_INTERVAL=15          # seconds between subgraph polls
SLIPPAGE=0.02             # max acceptable price slippage (2%)

# ── Telegram alerts (optional but recommended) ───────────────────
# Get a bot token from @BotFather on Telegram, then:
#   python telegram_bot.py --get-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 30-Day Trial settings (used by monthly_trial.py) ─────────────
TRIAL_DAILY_BUDGET=50     # USDC paper budget per day
TRIAL_MAX_POSITION=5      # max per trade during trial
TRIAL_DAILY_STOP=-15      # pause bot if today's loss exceeds this
TRIAL_MONTHLY_STOP=-80    # halt trial if total loss exceeds this
